# Application configuration. Copy to .env.app and replace the placeholder keys.
POSTGRES_URL=postgresql://localhost:5432/assessoriadb

GEMINI_API_KEY=replace-with-gemini-key
GROQ_API_KEY=replace-with-groq-key

MONGODB_URI=mongodb://localhost:27017
MONGODB_DBNAME=assessoria

LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE=logs/app.log
APP_TIMEZONE=America/Sao_Paulo

AGENT_EXECUTION_TIMEOUT_SECONDS=120
LLM_REQUEST_TIMEOUT_SECONDS=30

QDRANT_API_KEY=replace-with-qdrant-key
QDRANT_URL=replace-with-qdrant-url
HISTORY_COLLECTION_NAME=session-history
FAQ_COLLECTION_ALIAS=faq-current
FAQ_COLLECTION_PREFIX=faq-chunks
EMBEDDING_DIMMENSIONS=768

FAQ_CHUNK_SIZE=700
FAQ_CHUNK_OVERLAP=150
FAQ_INGESTION_BATCH_SIZE=50
# Value between 0 and 1; calibrate it for the embedding model and FAQ content.
FAQ_SEARCH_SCORE_THRESHOLD=0.52
INGEST_FAQ_PDF=false

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=cole_a_chave_aqui
LANGSMITH_PROJECT=assessor-ia

# Google web login and separate, per-user Calendar consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional separate OAuth client marked for AI agents (falls back to login client).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/calendar/google/callback
APP_FRONTEND_URL=http://localhost:8000/
# Use false only for localhost development; HTTPS deployments must use true.
AUTH_SECURE_COOKIES=false
# Deployment-managed Fernet key; never commit a real value.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_KEY_ID=v1
# REST needs no Workspace Developer Preview enrollment. MCP is optional.
GOOGLE_CALENDAR_TRANSPORT=rest
GOOGLE_CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1
